{
  "info": {
    "_postman_id": "a6104278-386f-40e8-a15f-5374be21015f",
    "name": "AgroScale Backend API",
    "description": "Complete Postman collection for testing AgroScale Cow Weight Monitoring & Analytics API backend.\n\n### Quick Start:\n1. Ensure backend is running at `http://localhost:3002`\n2. Run `02. Auth -> Login - Farmer 1 (John Doe)` first. This will automatically set the `jwtToken` variable for all authenticated requests.\n3. Test IoT measurement ingestion, Cow CRUD, and Dashboard analytics endpoints.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3002",
      "type": "string"
    },
    {
      "key": "iotApiKey",
      "value": "your-secret-iot-api-key",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "numericCowId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "deviceId",
      "value": "esp32-gateway-01",
      "type": "string"
    },
    {
      "key": "cowId",
      "value": "COW-001",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "01. System & Health",
      "item": [
        {
          "name": "System Health Check",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": ["{{baseUrl}}"],
              "path": ["health"]
            },
            "description": "Checks database connectivity and backend server status."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Server and database are healthy', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.status).to.eql('ok');",
                  "    pm.expect(jsonData.db).to.eql('ok');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02. Authentication",
      "item": [
        {
          "name": "Login - Farmer 1 (John Doe)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer1@agroscale.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates Farmer 1 and automatically populates the `jwtToken` collection variable upon success."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns JWT token and saves to variable', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.expect(jsonData).to.have.property('farmer');",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "    console.log('Successfully set jwtToken:', jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Login - Farmer 2 (Jane Smith)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"farmer2@agroscale.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "auth", "login"]
            },
            "description": "Authenticates Farmer 2 and saves `jwtToken` to collection variables."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns JWT token and saves to variable', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('token');",
                  "    pm.collectionVariables.set('jwtToken', jsonData.token);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03. IoT Ingestion (ESP32 Gateway)",
      "item": [
        {
          "name": "Ingest Weight Measurement (ESP32)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "x-api-key",
                "value": "{{iotApiKey}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"device_id\": \"{{deviceId}}\",\n  \"cow_id\": \"{{cowId}}\",\n  \"weight_kg\": 425.5,\n  \"measured_at\": \"2026-09-19T10:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/iot/measurements",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "iot", "measurements"]
            },
            "description": "Simulates an ESP32 gateway transmitting a cow weight reading. Auth via `x-api-key` header."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 201 Created', function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "pm.test('Returns measurement ID and classification', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.have.property('measurement_id');",
                  "    pm.expect(jsonData).to.have.property('cow_id');",
                  "    pm.expect(jsonData).to.have.property('classification');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04. Livestock Management (Cows)",
      "item": [
        {
          "name": "List All Cows",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/cows",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cows"]
            },
            "description": "Retrieves all cows registered under the authenticated farmer."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test('Returns array of cows', function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData).to.be.an('array');",
                  "    if (jsonData.length > 0) {",
                  "        pm.collectionVariables.set('numericCowId', jsonData[0].id.toString());",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Register New Cow",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cowId\": \"COW-101\",\n  \"breed\": \"Angus\",\n  \"gender\": \"Female\",\n  \"birthDate\": \"2024-01-15T00:00:00.000Z\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/cows",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "cows"]
            },
            "description": "Registers a new cow in the database."
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status code is 200 or 201', function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
