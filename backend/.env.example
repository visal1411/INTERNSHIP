# Express Backend Environment Configuration Template
# Copy to .env or .env.development / .env.production as needed

# Server Port
PORT=3002

# PostgreSQL Database Connection URL:
# - Local Docker: "postgresql://agro_user:agro_password@localhost:5433/agro_scale_db?schema=public"
# - Deployed DB:   "postgresql://user:pass@host:5432/dbname?sslmode=require"
DATABASE_URL="postgresql://agro_user:agro_password@localhost:5433/agro_scale_db?schema=public"

# Security & Credentials
IOT_API_KEY="your_iot_key"
JWT_SECRET="your_jwt_secret"

# ML Classification Service URL:
# - Local ML Service:    "http://127.0.0.1:5000"
# - Deployed Railway ML: "https://your-ml-app.up.railway.app"
ML_SERVICE_URL="http://127.0.0.1:5000"

# Allowed Frontend Origins (Comma-separated if multiple):
# - Localhost:  "http://localhost:5173,http://localhost:3000"
# - Production: "https://your-frontend-domain.com"
FRONTEND_URL="http://localhost:5173,http://localhost:3000"

# Optional Loki Logger Configuration
LOKI_HOST=""
LOKI_USER=""
LOKI_PASSWORD=""
